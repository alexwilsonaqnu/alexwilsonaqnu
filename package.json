{
  "name": "fpna-agents",
  "version": "0.1.0",
  "private": true,
  "description": "The Agentic Office of the CFO — FP&A Decision Layer on the Claude Agent SDK. Every number is read or computed by Anaplan; the model never originates a figure.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/hooks/*.test.mjs tests/evals/*.test.mjs",
    "test:hooks": "node --test tests/hooks/*.test.mjs",
    "ledger:show": "node src/ledger/cli.mjs",
    "web:server": "node --experimental-strip-types src/web/server.ts",
    "web:build": "tsc -p tsconfig.json",
    "web": "npm run web:build && node dist/web/server.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.10"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
