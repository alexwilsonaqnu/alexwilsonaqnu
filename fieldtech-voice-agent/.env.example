# Copy to .env and fill in. Nothing here is read automatically — export it:
#   set -a; source .env; set +a
#
# Two keys is the whole setup. No cloud project, no gcloud, no ADC.

# ---- brain: Claude (default) -------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- voice: ElevenLabs (default) ---------------------------------------------
ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb


# ================== everything below is optional ==============================

# Model ids are config, never literals in agent code — a swap is an env change.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EVAL_MODEL=claude-haiku-4-5

# Depth control on Claude is `effort`, not temperature (sampling params are rejected).
# "low" keeps thinking on and stays inside a phone call's latency budget.
# Raise to "high" for harder diagnostics at the cost of a longer pause.
# CLAUDE_EFFORT=low

# Server-side refusal fallback: re-runs a declined request on a recommended model
# rather than dropping the call. Set to empty to disable.
# ANTHROPIC_FALLBACKS=default

# ---- alternate voice provider ------------------------------------------------
# FISH_AUDIO_API_KEY=...
# FISH_AUDIO_VOICE_ID=...

# ---- alternate brain: Gemini on Model Garden (needs gcloud ADC) ---------------
# LLM_PROVIDER=gemini
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EVAL_MODEL=gemini-3.5-flash-lite

# ---- misc --------------------------------------------------------------------
# SERVICE_MATTERS_URL=https://search.servicematters.com/search
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
